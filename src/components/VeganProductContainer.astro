---
import astroLogo from '../assets/astro.svg';
import background from '../assets/background.svg';
import VeganProduct from '../components/VeganProduct.astro';

import type { ComponentProps } from 'astro/types';

type ProductProps = ComponentProps<typeof VeganProduct>;

const { products = [] }: { products?: ProductProps[] } = Astro.props;

---

<div id="container">

	<div class="row row-cols-6 gx-1 px-16">

		{
			products.map((product, index) => {
				
				return <VeganProduct 
						{ ...product }
					/>
				
			})
		}

	</div>

</div>

<style>

	.px-16 {
		padding-left: 15rem;
		padding-right: 15rem;
	}

</style>